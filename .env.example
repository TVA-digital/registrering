# Kopier til .env (lokalt) eller legg inn under Settings → Environment Variables i Vercel.
SUPABASE_URL=https://<prosjekt-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key fra Supabase → Project Settings → API Keys>
ADMIN_PASSWORD=<minst 12 tegn>
# Valgfritt
PRIVACY_URL=https://www.tvaksjonen.no/personvern
# Nødmodulen for ansvarlige (engangskode på e-post via Resend)
RESEND_API_KEY=<API-nøkkel fra resend.com>
EPOST_AVSENDER=TV-aksjonen <noreply@ditt-verifiserte-domene.no>
